---
interface Props { eyebrow?: string; title: string; lead?: string; crumbs?: { href: string; label: string }[] }
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
const all = [{ href: "/", label: "Главная" }, ...crumbs];
---
<section class="ph">
  <div class="wrap">
    <nav class="crumbs" aria-label="Хлебные крошки">{all.map((c, i) => <><a href={c.href}>{c.label}</a>{i < all.length - 1 && <span>/</span>}</>)}</nav>
    <div class="in">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1 set:html={title} />
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: all.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.label, item: "https://perfectbalance.club" + c.href })) })} />
<style>
  .ph{background:var(--black);color:#fff;padding-bottom:clamp(40px,6vw,72px)}
  .ph .crumbs{color:#8f8f8f}
  .in{display:grid;gap:18px;max-width:880px;margin-top:clamp(24px,4vw,44px)}
  .in :global(h1){font-size:clamp(30px,4.6vw,54px)}
  .lead{font-size:clamp(16px,1.5vw,19px);color:#cfcfcf;max-width:62ch}
</style>
