---
// Первый экран главной: текст + коллаж из фото + мини-калькулятор «сколько клиентов нужно».
// Формула мини-калькулятора совпадает с основным калькулятором при значениях по умолчанию (чек 750 ₽, продукты 35%, упаковка 60 ₽, курьер 150 ₽ на 2 дня, постоянные 210 000 ₽).
import { FACTS } from "../data/facts";
const years = new Date().getFullYear() - FACTS.since;
---
<section class="hero">
  <div class="bg" aria-hidden="true"><div class="glow"></div><div class="grid-lines"></div><div class="giant">PERFECT BALANCE</div></div>
  <div class="wrap hero-in">
    <div class="h-txt">
      <span class="kick">Франшиза Perfect Balance</span>
      <h1>Свой бизнес на&nbsp;доставке правильного питания</h1>
      <div class="payback">
        <div class="pb-main"><b class="num">10–14</b><span>месяцев<br>окупаемость</span></div>
        <i></i>
        <div class="pb-side"><b class="num">от 350 тыс. ₽</b><span>паушальный взнос</span></div>
      </div>
      <p class="lead">Работайте на себя и зарабатывайте от 200 000 ₽ в месяц — по системе, которая уже работает в 24 городах.</p>
      <div class="ctas">
        <a class="btn" href="#zayavka">Получить расчёт окупаемости</a>
        <a class="txtlink" href="#calc">или посчитать самому ↓</a>
      </div>
    </div>

    <div class="collage">
      <figure class="ph ph1"><img src="/img/spread.webp" alt="Дневные рационы Perfect Balance" width="796" height="1146" fetchpriority="high" /></figure>
      <figure class="ph ph2"><img src="/img/boxes.webp" alt="Контейнеры с блюдами Perfect Balance" width="1000" height="749" /></figure>
      <div class="tag t1"><b>26%</b><span>маржинальность сети</span></div>
      <div class="tag t2"><b>840</b><span>блюд в меню за год</span></div>

      <form class="mini" data-mini aria-label="Быстрый расчёт">
        <span class="mini-k">Быстрый расчёт</span>
        <label for="mini-goal">Хочу зарабатывать в месяц</label>
        <output class="mini-goal num" data-o="goal">250 000 ₽</output>
        <input id="mini-goal" type="range" min="100000" max="500000" step="10000" value="250000" />
        <div class="mini-res">
          <div><b class="num" data-o="cl">44</b><span>клиента в день</span></div>
          <div><b class="num" data-o="pb">11</b><span>мес. окупаемость</span></div>
        </div>
      </form>
    </div>
  </div>

  <div class="strip">
    <div class="wrap strip-in">
      <div class="cell">
        <span class="lbl">Прибыль сети за 2021</span>
        <b class="big num"><span data-count="117">117</span><small>млн ₽</small></b>
        <span class="bar"><i style="--w:100%"></i></span>
      </div>
      <div class="cell">
        <span class="lbl">Средняя маржинальность</span>
        <div class="row">
          <svg class="ring" viewBox="0 0 44 44" aria-hidden="true"><circle cx="22" cy="22" r="18" fill="none" stroke="#2a2a2a" stroke-width="6"/><circle class="arc" cx="22" cy="22" r="18" fill="none" stroke="#C70D00" stroke-width="6" pathLength="100" stroke-dasharray="26 100" transform="rotate(-90 22 22)"/></svg>
          <b class="big num"><span data-count="26">26</span><small>%</small></b>
        </div>
      </div>
      <div class="cell">
        <span class="lbl">Городов в сети</span>
        <div class="row">
          <b class="big num"><span data-count={FACTS.cities}>{FACTS.cities}</span></b>
          <span class="dots" aria-hidden="true">{Array.from({ length: FACTS.cities }, (_, i) => <i style={`--i:${i}`}></i>)}</span>
        </div>
      </div>
      <div class="cell">
        <span class="lbl">Подписка, оплата вперёд</span>
        <b class="big num">1–30<small>дней</small></b>
        <span class="scale" aria-hidden="true">{Array.from({ length: 30 }, (_, i) => <i style={`--i:${i}`}></i>)}</span>
      </div>
    </div>
  </div>
</section>
<script>
  const fmt = (n: number) => new Intl.NumberFormat("ru-RU").format(n) + " ₽";
  document.querySelectorAll<HTMLFormElement>("[data-mini]").forEach((f) => {
    const r = f.querySelector("input")!, o = (k: string) => f.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const perClient = 30 * (750 * (1 - 0.35) - 60 - 75), fixed = 210000, inv = 350000 + 150000 + 200000 + 27000 + 30000 + 150000 + 200000;
    const calc = () => {
      const goal = Number(r.value), cl = Math.ceil((goal + fixed) / perClient);
      let cum = -inv, m = 0; while (cum < 0 && m < 60) { m++; cum += cl * Math.min(1, m / 8) * perClient - fixed; }
      o("goal").textContent = fmt(goal); o("cl").textContent = String(cl); o("pb").textContent = String(m);
      r.style.setProperty("--p", ((goal - 100000) / 400000) * 100 + "%");
    };
    r.addEventListener("input", calc); f.addEventListener("submit", (e) => e.preventDefault()); calc();
  });
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>(".hero [data-count]").forEach((el) => {
      const to = Number(el.dataset.count), t0 = performance.now();
      const step = (t: number) => { const k = Math.min(1, (t - t0) / 1400); el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(step); };
      requestAnimationFrame(step);
    });
  }
</script>
<style>
  .hero{position:relative;overflow:hidden;background:var(--black);color:#fff;min-height:calc(100svh - var(--hdr));display:flex;flex-direction:column}
  .bg{position:absolute;inset:0;pointer-events:none}
  .glow{position:absolute;right:-10%;top:-20%;width:70%;height:120%;background:radial-gradient(closest-side,rgba(199,13,0,.38),transparent);filter:blur(20px);animation:breathe 9s ease-in-out infinite alternate}
  .grid-lines{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);background-size:64px 64px;mask-image:linear-gradient(180deg,#000,transparent 85%)}
  .giant{position:absolute;left:0;bottom:clamp(80px,7vw,120px);white-space:nowrap;font-weight:800;font-size:clamp(90px,14vw,210px);line-height:.8;letter-spacing:-.02em;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.09);animation:slide 40s linear infinite alternate}
  @keyframes breathe{to{transform:translate(-6%,6%) scale(1.1)}}
  @keyframes slide{to{transform:translateX(-25%)}}
  .hero-in{flex:1;width:100%;position:relative;display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(24px,3vw,48px);align-items:center;padding-block:clamp(28px,3vw,56px)}
  .h-txt{display:grid;gap:clamp(14px,2svh,22px)}
  .badge{display:inline-flex;align-items:center;gap:10px;width:max-content;max-width:100%;font-size:13px;font-weight:600;padding:8px 14px;border:1px solid #333;background:rgba(255,255,255,.04)}
  .dot{width:8px;height:8px;border-radius:50%;background:#2BB36A;box-shadow:0 0 0 0 rgba(43,179,106,.6);animation:pulse 2s infinite}
  @keyframes pulse{70%{box-shadow:0 0 0 10px rgba(43,179,106,0)}100%{box-shadow:0 0 0 0 rgba(43,179,106,0)}}
  h1{font-size:clamp(34px,min(3.3vw,5.6svh),64px);letter-spacing:-.01em}
  .lead{font-size:clamp(17px,1.15vw,22px);color:#cfcfcf;max-width:52ch}
  .ctas{display:flex;flex-wrap:wrap;gap:12px}
  .trust{list-style:none;margin:0;padding:18px 0 0;border-top:1px solid #262626;display:flex;flex-wrap:wrap;gap:10px 28px;font-size:14px;color:#a9a9a9}
  .trust b{color:#fff}
  /* коллаж */
  .collage{position:relative;height:clamp(400px,min(36vw,calc(100svh - var(--hdr) - 330px)),680px)}
  .ph{position:absolute;margin:0;overflow:hidden;box-shadow:0 30px 70px rgba(0,0,0,.6)}
  .ph img{width:100%;height:100%;object-fit:cover}
  .ph1{right:0;top:0;width:68%;height:88%}
  .ph1 img{animation:kb 24s ease-in-out infinite alternate}
  .ph2{left:0;bottom:4%;width:48%;height:40%;border:6px solid var(--black)}
  @keyframes kb{to{transform:scale(1.12) translate(-3%,-2%)}}
  .tag{position:absolute;display:grid;padding:12px 16px;background:#fff;color:#111;box-shadow:0 18px 40px rgba(0,0,0,.4);animation:float 6s ease-in-out infinite}
  .tag b{font-size:24px;font-weight:800;line-height:1}.tag span{font-size:12px;color:#626262}
  .t1{right:-6px;top:52%;background:var(--red);color:#fff;animation-delay:-3s}.t1 span{color:#ffd9d6}
  .t2{left:12%;top:8%}
  @keyframes float{50%{transform:translateY(-10px)}}
  /* мини-калькулятор */
  .mini{position:absolute;left:4%;top:24%;width:min(clamp(280px,18vw,340px),62%);background:rgba(18,18,18,.86);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid #333;padding:20px;display:grid;gap:8px;z-index:2}
  .mini-k{font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--red)}
  .mini label{font-size:13px;color:#bdbdbd}
  .mini-goal{font-size:26px;font-weight:800}
  .mini input{--p:37.5%;appearance:none;-webkit-appearance:none;height:6px;background:linear-gradient(90deg,var(--red) var(--p),#3a3a3a var(--p));outline-offset:6px}
  .mini input::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;border-radius:50%;background:#fff;border:4px solid var(--red);cursor:grab}
  .mini input::-moz-range-thumb{width:16px;height:16px;border-radius:50%;background:#fff;border:4px solid var(--red);cursor:grab}
  .mini-res{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px}
  .mini-res div{background:#fff;color:#111;padding:10px 12px;display:grid}
  .mini-res b{font-size:28px;font-weight:800;line-height:1}.mini-res span{font-size:12px;color:#626262}
  .mini-link{font-size:13px;font-weight:700;text-decoration:none;color:#fff;margin-top:4px}.mini-link:hover{color:var(--red)}

  .kick{font-size:clamp(12px,.75vw,14px);font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#bdbdbd;display:flex;align-items:center;gap:12px}
  .kick::before{content:"";width:36px;height:2px;background:var(--red)}
  .payback{display:flex;align-items:center;gap:clamp(16px,1.8vw,32px);flex-wrap:nowrap}
  @media (max-width:560px){.payback{flex-wrap:wrap}.payback > i{display:none}}
  .payback > i{width:1px;align-self:stretch;background:#333}
  .pb-main{display:flex;align-items:center;gap:14px}
  .pb-main b{font-size:clamp(46px,min(4.2vw,7svh),80px);font-weight:800;line-height:.9;color:var(--red);letter-spacing:-.02em}
  .pb-main span{font-size:clamp(14px,.95vw,18px);font-weight:700;line-height:1.2;text-transform:uppercase;letter-spacing:.06em}
  .pb-side{display:grid;gap:2px}
  .pb-side b{font-size:clamp(20px,1.6vw,30px);font-weight:800}
  .pb-side span{font-size:clamp(13px,.8vw,15px);color:#a9a9a9}
  .txtlink{align-self:center;font-weight:700;color:#cfcfcf;text-decoration:none;border-bottom:1px solid #555;padding-bottom:2px}
  .txtlink:hover{color:#fff;border-color:var(--red)}
  .strip-in .cell{display:grid;gap:8px;align-content:start;padding:clamp(14px,1.2vw,22px) clamp(16px,1.6vw,28px);border-left:1px solid #222;position:relative;transition:background .3s}
  .strip-in .cell:first-child{border-left:0;padding-left:0}
  .strip-in .cell::before{content:"";position:absolute;left:0;right:0;top:-1px;height:2px;background:var(--red);transform:scaleX(0);transform-origin:left;transition:transform .4s}
  .strip-in .cell:hover::before{transform:scaleX(1)}
  .lbl{font-size:clamp(11px,.68vw,13px);font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#8f8f8f}
  .big{font-size:clamp(34px,2.8vw,56px);font-weight:800;line-height:1;display:flex;align-items:baseline;gap:8px}
  .big small{font-size:.38em;font-weight:700;color:#a9a9a9}
  .row{display:flex;align-items:center;gap:14px}
  .bar{display:block;height:4px;background:#222}.bar i{display:block;height:100%;width:var(--w);background:linear-gradient(90deg,var(--red),#ff5a4d);animation:fillx 1.6s cubic-bezier(.2,.8,.2,1) both}
  @keyframes fillx{from{width:0}}
  .ring{width:clamp(40px,3vw,56px);height:auto;flex:none}
  .ring .arc{animation:ring 1.6s cubic-bezier(.2,.8,.2,1) both}
  @keyframes ring{from{stroke-dasharray:0 100}}
  .dots{display:grid;grid-template-columns:repeat(12,7px);gap:4px}
  .dots i{width:7px;height:7px;border-radius:50%;background:#fff;opacity:0;animation:dot .3s ease forwards;animation-delay:calc(var(--i) * 45ms)}
  .dots i:nth-child(3n){background:var(--red)}
  @keyframes dot{to{opacity:1}}
  .scale{display:grid;grid-template-columns:repeat(30,1fr);gap:2px;height:10px}
  .scale i{background:#333}.scale i:nth-child(-n+30){background:linear-gradient(#fff,#bbb);opacity:calc(.25 + var(--i) * .025)}
  @media (prefers-reduced-motion:reduce){.bar i,.ring .arc,.dots i{animation:none;opacity:1}}
  /* полоса цифр */
  .strip{position:relative;border-top:1px solid #222;background:rgba(255,255,255,.02)}
  .strip-in{display:grid;grid-template-columns:repeat(4,1fr)}
  .strip-in > .cell-old{padding:clamp(18px,1.6vw,28px) 20px;border-left:1px solid #222;display:grid;gap:4px}
  .strip-in > .cell-old:first-child{border-left:0;padding-left:0}
  .strip .old-b{font-size:clamp(28px,2.3vw,44px);font-weight:800;line-height:1}
  .strip .old-span{font-size:clamp(13px,.75vw,15px);color:#a9a9a9}
  @media (max-width:980px){
    .hero-in{grid-template-columns:1fr}
    .collage{height:520px;max-width:560px;width:100%;margin-inline:auto}
    .strip-in{grid-template-columns:1fr 1fr}.strip-in > .cell:nth-child(3){border-left:0;padding-left:0}
  }
  @media (max-width:520px){
    .collage{height:auto;display:grid;gap:12px}
    .ph,.tag,.mini{position:static;width:auto;height:auto}
    .ph1{height:320px}.ph2,.tag{display:none}
    .mini{order:-1}
    .giant{bottom:auto;top:20px}
  }
  @media (prefers-reduced-motion:reduce){.glow,.giant,.ph1 img,.tag,.dot{animation:none}}
</style>
