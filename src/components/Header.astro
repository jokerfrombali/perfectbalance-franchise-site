---
import { NAV, FACTS } from "../data/facts";
const { dark = true } = Astro.props;
const path = Astro.url.pathname;
---
<header class:list={["hdr", { light: !dark }]}>
  <div class="wrap bar">
    <a href="/" class="logo" aria-label="Perfect Balance — на главную"><img src="/img/logo.svg" alt="Perfect Balance" width="118" height="40" /></a>
    <nav aria-label="Основное меню">
      <ul>
        {NAV.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="contact">
      <span class="phone num">{FACTS.phone}</span>
      <a class="btn sm" href="#zayavka">Получить расчёт</a>
    </div>
    <button class="burger" aria-label="Меню" aria-expanded="false" id="burger"><span></span><span></span></button>
  </div>
</header>
<script>
  const b = document.getElementById("burger");
  b?.addEventListener("click", () => {
    const open = document.body.classList.toggle("nav-open");
    b.setAttribute("aria-expanded", String(open));
  });
</script>
<style>
  .hdr{background:var(--black);color:#fff;position:sticky;top:0;z-index:50;border-bottom:1px solid #1f1f1f}
  .hdr.light{background:#fff;color:var(--ink);border-bottom-color:var(--line)}
  .hdr.light .logo img{filter:invert(1)}
  .bar{display:flex;align-items:center;gap:clamp(20px,2.4vw,48px);min-height:var(--hdr)}
  .logo img{width:clamp(118px,8vw,150px);height:auto}
  nav{flex:1}
  nav ul{list-style:none;display:flex;gap:clamp(14px,1.6vw,34px);margin:0;padding:0;flex-wrap:nowrap}
  nav a{white-space:nowrap}
  @media (max-width:1320px){.phone{display:none}}
  nav a{text-decoration:none;font-size:clamp(14px,.85vw,17px);font-weight:600;opacity:.85}
  nav a:hover,nav a[aria-current]{opacity:1;color:var(--red)}
  .hdr:not(.light) nav a[aria-current]{color:#fff;box-shadow:inset 0 -2px 0 var(--red)}
  .contact{display:flex;align-items:center;gap:16px}
  .phone{font-weight:700;font-size:clamp(14px,.85vw,17px);white-space:nowrap}
  .btn.sm{padding:clamp(12px,.8vw,15px) clamp(18px,1.2vw,24px);font-size:clamp(13px,.78vw,15px)}
  .burger{display:none;background:none;border:0;color:inherit;width:40px;height:40px;cursor:pointer;flex-direction:column;justify-content:center;gap:7px;align-items:center}
  .burger span{display:block;width:24px;height:2px;background:currentColor}
  @media (max-width:1080px){
    .phone{display:none}
    nav{position:fixed;inset:var(--hdr) 0 auto 0;background:inherit;padding:16px var(--g) 24px;display:none;border-bottom:1px solid #222}
    :global(body.nav-open) nav{display:block;background:var(--black)}
    :global(body.nav-open) .hdr.light nav{background:#fff}
    nav ul{flex-direction:column;gap:14px}
    nav a{font-size:17px}
    .burger{display:flex;margin-left:auto}
    .contact{margin-left:auto}
  }
  @media (max-width:560px){.contact .btn{display:none}}
</style>
