---
// Статья. Пока текста нет, выводится утверждённая структура H2–H3 из ТЗ и страница закрыта от индексации (noindex).
// Когда текст готов: положить src/content/articles/<id>.md — он заменит заготовку и снимет noindex.
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Calculator from "../../../components/Calculator.astro";
import LeadForm from "../../../components/LeadForm.astro";
import hubs from "../../../data/hubs.json";
import articles from "../../../data/articles.json";
export function getStaticPaths() { return articles.map((a) => ({ params: { hub: a.hub, slug: a.slug }, props: { a } })); }
const { a } = Astro.props as any;
const h = hubs.find((x) => x.slug === a.hub)!;
const mods = import.meta.glob("../../../content/articles/*.md", { eager: true }) as Record<string, any>;
const md = Object.entries(mods).find(([p]) => p.endsWith(`/${a.id}.md`))?.[1];
const related = articles.filter((x) => x.hub === a.hub && x.id !== a.id).slice(0, 3);
const COM: Record<string, [string, string]> = { "P-FR": ["/franshiza/", "Условия франшизы Perfect Balance"], "P-PRICE": ["/stoimost/", "Стоимость и инвестиции"], "P-ECO": ["/ekonomicheskaya-model/", "Экономическая модель точки"], "P-SEL": ["/otbor-partnerov/", "Как мы отбираем партнёров"], "P-CASE": ["/keysy/", "Кейсы партнёров"], "P-CITY": ["/goroda/", "Свободные города"], "P-CMP": ["/sravnenie-franshiz/", "Сравнение франшиз ПП"], "P-MENU": ["/menu-i-ttk/", "Меню и техкарты франшизы"], "P-MKT": ["/marketing-podderzhka/", "Маркетинг для партнёров"], "P-OPS": ["/crm-i-operacii/", "CRM и поддержка"], "P-MKTDATA": ["/rynok/", "Рынок доставки ПП"] };
const com = COM[a.com] ?? COM["P-FR"];
---
<Base title={md?.frontmatter?.title ?? `${a.title} | Perfect Balance`} description={md?.frontmatter?.description ?? `${a.title}: разбор по шагам, расчёты и чек-лист для будущего владельца доставки правильного питания.`} noindex={!md} dark={false}
  schema={{ "@context": "https://schema.org", "@type": "Article", headline: a.title, publisher: { "@type": "Organization", name: "Perfect Balance" } }}>
  <PageHero eyebrow={h.name} title={a.title} crumbs={[{ href: "/blog/", label: "Блог" }, { href: `/blog/${h.slug}/`, label: h.name }, { href: `/blog/${h.slug}/${a.slug}/`, label: a.title }]} />
  <section class="section">
    <div class="wrap art">
      <article class="prose">
        {md ? <md.Content /> : (
          <>
            <p class="todo">Статья в работе — ниже утверждённый план</p>
            <nav class="toc" aria-label="Содержание"><b>Содержание</b><ol>{a.h2.map((x: any) => <li>{x.h}{x.h3.length > 0 && <ol>{x.h3.map((y: string) => <li>{y}</li>)}</ol>}</li>)}</ol></nav>
            {a.h2.map((x: any) => <><h2>{x.h}</h2>{x.h3.map((y: string) => <h3>{y}</h3>)}</>)}
          </>
        )}
      </article>
      <aside class="side">
        <div class="card"><span class="eyebrow">Посчитайте</span><h3>Сколько вы заработаете на своей точке</h3><a class="btn" href="/kalkulyator/">Открыть калькулятор</a></div>
        <div class="card"><h3>По теме</h3><a href={com[0]}>{com[1]} →</a>{related.map((r) => <a href={`/blog/${r.hub}/${r.slug}/`}>{r.title}</a>)}</div>
      </aside>
    </div>
  </section>
  <section class="section soft"><div class="wrap"><div class="head"><h2>Проверьте доход на цифрах сети</h2></div><Calculator compact /></div></section>
  <LeadForm source={"blog-" + a.id} />
</Base>
<style>
  .art{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:56px;align-items:start}
  .side{display:grid;gap:18px;position:sticky;top:96px}
  .side a{text-decoration:none;font-size:14px}.side a:hover{color:var(--red)}
  .toc{background:var(--soft);padding:20px 24px}.toc ol{margin:8px 0 0;padding-left:20px;display:grid;gap:4px}
  @media (max-width:960px){.art{grid-template-columns:1fr}.side{position:static}}
</style>
